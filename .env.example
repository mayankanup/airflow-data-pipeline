# Copy to .env for local runs (never commit .env)
OLTP_DSN=dbname=oltp user=postgres password=postgres host=localhost port=5433
OLAP_DSN=dbname=olap user=postgres password=postgres host=localhost port=5434

# In-Compose DSNs (service names)
# OLTP: postgres://postgres:postgres@oltp-postgres:5432/oltp
# OLAP: postgres://postgres:postgres@olap-postgres:5432/olap

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__WEBSERVER__SECRET_KEY=changeme-secret-key
AIRFLOW_UID=50000

# Metabase (from laptop) -> OLAP
# Host: localhost, Port: 5434, DB: olap, User: metabase_reader, Password: metabase_reader
# From metabase container -> host: olap-postgres:5432, DB: olap
METABASE_OLAP_HOST=localhost
METABASE_OLAP_PORT=5434
METABASE_OLAP_DB=olap
METABASE_OLAP_USER=metabase_reader
METABASE_OLAP_PASSWORD=metabase_reader
METABASE_URL=http://localhost:3000
